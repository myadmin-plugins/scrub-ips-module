{
	"name": "ganesh/myadmin-scrub-ips-module",
	"type": "myadmin-plugin",
	"description": "Scrub Ips services module plugin for MyAdmin",
	"keywords": [
		"scrub",
		"scrub_ip",
		"scrub-ip",
		"scrub-ips"
	],
	"license": "LGPL-2.1-only",
	"authors": [
		{
			"name": "Ganesh R",
			"homepage": "https:\/\/my.interserver.net\/"
		}
	],
	"config": {
		"bin-dir": "vendor\/bin",
		"minimum-stability": "dev",
		"allow-plugins": {
			"detain/myadmin-plugin-installer": true
		}
	},
	"require": {
		"php": ">=5.0.0",
		"symfony/event-dispatcher": "^5.0@stable",
		"detain/myadmin-plugin-installer": "dev-master"
    },
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"Ganesh\\MyadminScrubIps\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Ganesh\\MyadminScrubIps\\Tests\\": "tests/"
		}
	}
}